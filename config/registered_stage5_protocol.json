    },
    {
      "role": "registered_stage4_execution_validator",
      "path": "src/quant_platform/orchestration/corrective_registered_rerun_executor.py"
    },
    {
      "role": "dataset_and_model_gate_pipeline",
      "path": "src/quant_platform/active_pipeline.py"
    },
    {
      "role": "exact_mode_schema",
      "path": "src/quant_platform/wizard_mode_replay.py"
    },
    {
      "role": "model_training_and_selection",
      "path": "src/quant_platform/ml_filter.py"
    },
    {
      "role": "registered_stage5_protocol_registry",
      "path": "src/quant_platform/orchestration/corrective_registered_learning_protocol.py"
    },
    {
      "role": "rl_feature_construction",
