{
  "schema_version": "thewiz.corrective_artifact_retention_policy.v1",
  "operational_receipt_directories": [
    "data/research/stage4_handoff_readiness",
    "data/research/l2_readiness_refresh",
    "data/research/scheduler_runtime_readiness",
    "data/research/wizard_comparator_review_controls",
    "data/research/wizard_reset_readiness",
    "data/research/wizard_proof_launcher_receipts",
    "data/research/wizard_unattended_external_preflights",
    "data/research/canonical_program_status"
